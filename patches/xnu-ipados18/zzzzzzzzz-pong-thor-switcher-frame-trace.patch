+
+/* A boot-wide bounded trace. Rendering only appends to memory. */
+struct ThorSwitcherFrame {
+	uint64_t enqueued, dequeued, ready, shown, drawn, gpuWriter;
+	uint32_t id;
+};
+
+struct ThorSwitcherCue {
+	uint64_t user, kernel;
+	unsigned phase;
+};
+
+LCK_GRP_DECLARE(thor_switcher_trace_group, "thor-switcher-trace");
+LCK_MTX_DECLARE(thor_switcher_trace_lock, &thor_switcher_trace_group);
+static ThorSwitcherFrame gSwitcherFrames[1152];
+static ThorSwitcherCue gSwitcherCues[96];
+static unsigned gSwitcherFrameCount, gSwitcherCueCount;
+static uint64_t gSwitcherTraceEnd, gSwitcherHardEnd;
+static bool gSwitcherTraceSealed;
+static thread_call_t gSwitcherTraceCall;
+
+static unsigned long long
+thorSwitcherMicros(uint64_t timestamp)
+{
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(timestamp, &ns);
+	return static_cast<unsigned long long>(ns / 1000);
+}
+
+static void
+thorSwitcherReport(thread_call_param_t, thread_call_param_t)
+{
+	lck_mtx_lock(&thor_switcher_trace_lock);
+	if (gSwitcherTraceSealed) {
+		lck_mtx_unlock(&thor_switcher_trace_lock);
+		return;
+	}
+	const uint64_t deadline = __atomic_load_n(&gSwitcherTraceEnd, __ATOMIC_RELAXED);
+	if (deadline > mach_absolute_time()) {
+		thread_call_enter_delayed(gSwitcherTraceCall, deadline);
+		lck_mtx_unlock(&thor_switcher_trace_lock);
+		return;
+	}
+	gSwitcherTraceSealed = true;
+	__atomic_store_n(&gSwitcherTraceEnd, 0, __ATOMIC_RELAXED);
+	lck_mtx_unlock(&thor_switcher_trace_lock);
+
+	IOLog("PONG SWITCHER: capture cues=%u swaps=%u full=%u retirement includes CPU writeback and surface-readiness misses\n",
+	    gSwitcherCueCount, gSwitcherFrameCount,
+	    gSwitcherFrameCount == sizeof(gSwitcherFrames) / sizeof(gSwitcherFrames[0]));
+	for (unsigned index = 0; index < gSwitcherCueCount; ++index) {
+		const ThorSwitcherCue &cue = gSwitcherCues[index];
+		IOLog("PONG SWITCHER CUE: phase=%u user_us=%llu kernel_us=%llu\n",
+		    cue.phase, thorSwitcherMicros(cue.user), thorSwitcherMicros(cue.kernel));
+	}
+	for (unsigned index = 0; index < gSwitcherFrameCount; ++index) {
+		const ThorSwitcherFrame &frame = gSwitcherFrames[index];
+		IOLog("PONG SWITCHER FRAME: swap=%u enqueue_us=%llu dequeue_us=%llu ready_us=%llu "
+		    "start_us=%llu done_us=%llu writer_wait_us=%llu\n", frame.id, thorSwitcherMicros(frame.enqueued),
+		    thorSwitcherMicros(frame.dequeued), thorSwitcherMicros(frame.ready),
+		    thorSwitcherMicros(frame.shown), thorSwitcherMicros(frame.drawn),
+		    thorSwitcherMicros(frame.gpuWriter));
+	}
+}
+
+extern "C" int thor_switcher_trace_arm(unsigned phase, uint64_t user);
+
+extern "C" int
+thor_switcher_trace_arm(unsigned phase, uint64_t user)
+{
+	const uint64_t now = mach_absolute_time();
+	uint64_t quiet, window;
+	nanoseconds_to_absolutetime(950ull * NSEC_PER_MSEC, &quiet);
+	nanoseconds_to_absolutetime(8ull * NSEC_PER_SEC, &window);
+	if (!user || user > now || now - user > quiet) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&thor_switcher_trace_lock);
+	if (gSwitcherTraceSealed) {
+		lck_mtx_unlock(&thor_switcher_trace_lock);
+		return 0;
+	}
+	if (!gSwitcherTraceCall) {
+		gSwitcherTraceCall = thread_call_allocate_with_priority(thorSwitcherReport,
+		    nullptr, THREAD_CALL_PRIORITY_LOW);
+		if (!gSwitcherTraceCall) {
+			lck_mtx_unlock(&thor_switcher_trace_lock);
+			return ENOMEM;
+		}
+		gSwitcherHardEnd = now + window;
+	}
+	if (gSwitcherCueCount < sizeof(gSwitcherCues) / sizeof(gSwitcherCues[0])) {
+		gSwitcherCues[gSwitcherCueCount++] = { user, now, phase };
+	}
+	const uint64_t deadline = now + quiet < gSwitcherHardEnd ? now + quiet : gSwitcherHardEnd;
+	__atomic_store_n(&gSwitcherTraceEnd, deadline, __ATOMIC_RELAXED);
+	thread_call_enter_delayed(gSwitcherTraceCall, deadline);
+	lck_mtx_unlock(&thor_switcher_trace_lock);
+	return 0;
+}
+
+static bool
+thorSwitcherTracing(uint64_t now)
+{
+	const uint64_t deadline = __atomic_load_n(&gSwitcherTraceEnd, __ATOMIC_RELAXED);
+	return deadline && now <= deadline;
+}
+
+static void
+thorSwitcherCapture(uint32_t swap, uint64_t enqueued, uint64_t dequeued,
+    uint64_t ready, uint64_t shown, uint64_t drawn, uint64_t gpuWriter)
+{
+	const uint64_t now = drawn ? drawn : mach_absolute_time();
+	if (!thorSwitcherTracing(now)) {
+		return;
+	}
+	lck_mtx_lock(&thor_switcher_trace_lock);
+	if (!gSwitcherTraceSealed &&
+	    gSwitcherFrameCount < sizeof(gSwitcherFrames) / sizeof(gSwitcherFrames[0])) {
+		gSwitcherFrames[gSwitcherFrameCount++] = { enqueued, dequeued, ready, shown, drawn, gpuWriter, swap };
+	}
+	lck_mtx_unlock(&thor_switcher_trace_lock);
+}
