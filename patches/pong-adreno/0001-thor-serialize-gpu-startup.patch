+static bool thor_device()
+{
+    char board[16] = {};
+    return PE_parse_boot_argn("arp0", board, sizeof(board)) &&
+        strncmp(board, "thor", sizeof(board)) == 0;
+}
+
+static bool wait_for_root()
+{
+    // I/O Kit starts the platform before BSD installs the initial root.
+    // Avoid blocking the root path or touching GPU resources if it failed.
+    for (unsigned waited = 0; waited < 30000; waited += 100) {
+        if (vnode_t root = vfs_rootvnode()) {
+            vnode_put(root);
+            return true;
+        }
+        IOSleep(100);
+    }
+    return false;
+}
+
+static bool vote_thor_parents(const PongPowerInputs &inputs)
+{
+    const unsigned mx = retained_corner(inputs.mx);
+    const unsigned cx = retained_corner(inputs.cx);
+    if (mx == 16 || cx == 16) {
+        record("SKIP Thor ARC AUX levels", 1, mx, cx);
+        return false;
+    }
+    if (!pong_rpmh_vote(inputs.mx.address, mx) || !pong_rpmh_vote(inputs.cx.address, cx)) {
+        record("FAIL Thor shared parent votes", 1, mx, cx);
+        return false;
+    }
+    record("Thor shared parent ARC votes acknowledged", 0, mx, cx);
+    return true;
+}
